package wasmcloud:host@0.1.3;

interface types {
  type workload-id = string;

  type component-id = string;

  variant call-error {
    no-target(option<string>),
    not-running(option<string>),
    not-exported(option<string>),
    failed(option<string>),
    other(option<string>),
  }
}

interface identity {
  use types.{workload-id, component-id};

  get-workload-id: func() -> workload-id;

  get-component-id: func() -> component-id;
}

interface cancel {
  type job-id = u64;

  current-job: func() -> job-id;

  request-cancel: func(job: job-id) -> bool;

  is-cancelled: func() -> bool;
}

interface workload-call {
  use types.{workload-id};

  resource target {
    open: static func(id: workload-id, %interface: string) -> option<target>;
    get-workload-id: func() -> workload-id;
    get-interface: func() -> string;
  }

  callable: func() -> map<string, list<string>>;
}

interface workload-lifecycle {
  use types.{workload-id, component-id};

  record version {
    major: u64,
    minor: u64,
    patch: u64,
    pre: option<string>,
    build: option<string>,
  }

  record interface-binding {
    namespace: string,
    %package: string,
    interfaces: list<string>,
    version: option<version>,
    name: option<string>,
    external-id: option<string>,
    config: list<tuple<string, string>>,
  }

  record workload-info {
    id: workload-id,
    name: string,
    namespace: string,
    service: option<component-id>,
    components: list<component-id>,
    interfaces: list<interface-binding>,
  }

  on-workload-bind: async func(workload: workload-info) -> result<_, string>;

  on-workload-unbind: async func(id: workload-id);
}

