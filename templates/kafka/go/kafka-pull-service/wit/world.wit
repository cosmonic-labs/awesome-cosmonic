package cosmonic-templates:kafka-pull-service;

// Pull-mode consumer as a long-running Service (`wasi:cli/run`). The GUEST
// owns the consumer: it opens, subscribes, drains `records()`, commits, and
// routes — full control over offsets, DLQ policy, and batching. The one
// long-lived instance also holds one long-lived producer, which is what makes
// consume-transform-produce fast (no per-record client bootstrap).
world kafka-pull-service {
    import wasi:cli/environment@0.2.0;
    import cosmonic:kafka/types@0.3.0;
    import cosmonic:kafka/consumer@0.3.0;
    import cosmonic:kafka/producer@0.3.0;
    export wasi:cli/run@0.3.0;
}
