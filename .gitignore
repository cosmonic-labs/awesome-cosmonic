# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Build output
build/
dist/
**/*.wasm

# wash keeps local state here, but `config.yaml` is a project's source: it is
# what names the build command and where the component lands, so `wash build`
# and CI both need it. Matched as `.wash/*` rather than `.wash/` so git still
# descends into the directory and the negation below can take effect.
.wash/*
!.wash/config.yaml

# Go
vendor/

# JavaScript / TypeScript
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/

# Model weights and large fixtures. Fetch these with a script, do not commit them.
# See CONTRIBUTING.md.
*.gguf
*.ggml
*.bin
*.safetensors
*.onnx
*.pt
*.wav
*.mp3
*.mp4

# macOS
.DS_Store
