package cosmonic:minimal-agent;

// What this agent harness may call, and the one function it serves.
//
// Imports: the model by alias (inference-types, models, chat), the tools the
// workload grants (tools) and the conversation (session). Nothing else: no
// network, no filesystem.
//
// Export: `cosmonic:agent/run` (unstable, feature `agent-run`), the typed run a
// host drives the agent through: a message in, events while it works, an
// outcome at the end. There is no HTTP handler, so nothing but its driver can
// reach it.
//
// This is the `cosmonic:agent/runnable-agent` world, spelled out so the list
// an operator reviews reads here at a glance. `wash wit fetch` (which
// `wash build` runs) fetches cosmonic:agent from ghcr.io into the generated,
// gitignored wit/deps.
world minimal-agent {
  import cosmonic:agent/inference-types@0.4.2;
  import cosmonic:agent/models@0.4.2;
  import cosmonic:agent/chat@0.4.2;
  import cosmonic:agent/session@0.4.2;
  import cosmonic:agent/tools@0.4.2;

  export cosmonic:agent/run@0.4.2;
}
