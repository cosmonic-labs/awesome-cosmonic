package cosmonic-templates:kafka-transactional;

// Exactly-once consume → transform → produce (read-process-write) as a
// long-running Service. A transactional producer commits the output records
// and the input offsets atomically; downstream readers with
// `isolation.level=read_committed` never see partial results.
//
// Every import here is 0.3.0. Environment variables are read through
// `std::env`, which the wasip2 target lowers to `wasi:cli/environment` on its
// own — importing that interface explicitly would pin this world to
// `wasi:cli@0.2.0`, since 0.3.0's `wasi:cli` carries only `run`, and a world
// naming two versions of one package cannot be resolved from the registry.
world kafka-transactional {
    import cosmonic:kafka/types@0.3.0;
    import cosmonic:kafka/consumer@0.3.0;
    import cosmonic:kafka/producer@0.3.0;
    export wasi:cli/run@0.3.0;
}
