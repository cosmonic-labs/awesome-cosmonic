package cosmonic-templates:kafka-transactional;

// A long-running service commits output records and input offsets atomically.
//
// `std::env` supplies environment variables without a second wasi:cli version.
world kafka-transactional {
    import cosmonic:kafka/consumer@0.5.0;
    import transaction: cosmonic:kafka/transaction@0.5.0;
    export wasi:cli/run@0.3.0;
}
