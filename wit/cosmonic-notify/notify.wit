/// Host-routed notifications and user responses. The host owns attribution,
/// reports platform capabilities, and adapts unsupported fields. Each
/// notification has exactly one terminal response, including across fan-out.
package cosmonic:notify@0.2.0;

interface types {
  /// What happens when the user activates an action (or the notification body).
  variant action-target {
    /// Open a relative Desktop route through cosmonic://navigate/<route>.
    /// Reject schemes, hosts, .., and leading //. Unknown routes only focus the window.
    deep-link(string),
    /// Open an HTTP or HTTPS URL. Other schemes return invalid.
    url(string),
    /// Return the response to the sender without a host-side action.
    callback,
  }

  record action {
    /// Nonempty action id, unique within the notification and echoed in responses.
    id: string,
    /// Button label shown to the user.
    label: string,
    target: action-target,
  }

  /// Inline reply. Unsupported platforms use a button with the same id.
  record text-input {
    id: string,
    /// Button label, e.g. "Reply".
    label: string,
    placeholder: option<string>,
  }

  enum urgency { low, normal, critical }

  record notification {
    /// Required, non-empty after trimming.
    title: string,
    body: string,
    urgency: urgency,
    /// Truncate to the smaller of max-actions and 8; log dropped actions.
    actions: list<action>,
    input: option<text-input>,
    /// Body-click target. None opens the sending workload's Desktop page.
    default-target: option<action-target>,
    /// Replaces this workload's notification with the same tag.
    tag: option<string>,
    /// Dismissal hint and request deadline in milliseconds. None or zero uses
    /// the host default. The host expires requests at the deadline even when
    /// the platform ignores dismissal; a host ceiling always bounds the wait.
    timeout-ms: option<u32>,
  }

  type notification-id = u64;

  variant response {
    /// The user clicked the notification body.
    activated,
    /// The user clicked a button; payload = the action id.
    action(string),
    /// The user submitted inline text: (input id, text).
    reply(tuple<string, string>),
    /// The user explicitly dismissed it.
    dismissed,
    /// Expired, withdrawn, cleared, or still pending at host shutdown.
    expired,
  }

  variant notify-error {
    /// Workload lacks permission or the host cannot identify the caller.
    denied,
    /// Workload or host rate limit exceeded. Retry as the hourly budget refills.
    throttled,
    /// No reachable notification service. capabilities.available reports this.
    unavailable,
    /// Malformed title, action ids, URL, or relative route, with detail.
    invalid(string),
    /// Backend/platform failure, with detail.
    platform(string),
  }

  record platform-capabilities {
    /// Whether notifications can be displayed. False makes post/request unavailable.
    available: bool,
    /// Primary backend key, such as os, mock, or none; identifies only the primary route.
    backend: string,
    actions: bool,
    inline-reply: bool,
    urgency: bool,
    /// Notifications persist in a system tray/center after display.
    persistent: bool,
    max-actions: u8,
  }
}

/// Raising notifications.
interface notifier {
  use types.{notification, notification-id, response, notify-error,
             platform-capabilities};

  /// Current platform capabilities. Cheap and side-effect free.
  capabilities: async func() -> platform-capabilities;

  /// Queue a notification and return its id. Responses arrive through events.pull.
  post: async func(n: notification) -> result<notification-id, notify-error>;

  /// Wait for exactly one terminal response, bounded by timeout-ms or the
  /// host default and always by the host ceiling.
  request: async func(n: notification) -> result<response, notify-error>;

  /// Withdraw a notification and resolve its response as expired.
  /// Unknown or terminal ids are a no-op.
  close: async func(id: notification-id) -> result<_, notify-error>;
}

/// Responses to posted notifications, queued per workload across invocations.
/// Components in one workload share the queue, rate budget, and settings.
interface events {
  use types.{notification-id, response, notify-error};

  record event {
    id: notification-id,
    response: response,
  }

  /// Drain queued responses, waiting at most max-wait-ms and the host ceiling.
  /// Zero polls. Returns an empty list on timeout. Delivery is at-most-once;
  /// overflow discards the oldest events and is logged.
  pull: async func(max-wait-ms: u32) -> result<list<event>, notify-error>;
}

/// Notification sending and response collection.
world notify-consumer {
  import notifier;
  import events;
}

/// Host-provided notification interfaces.
world host {
  export notifier;
  export events;
}
