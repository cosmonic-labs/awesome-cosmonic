package cosmonic:cron@0.1.0;

/// Handle scheduled firings.
///
/// The workload exports this interface for the scheduler to call when a schedule is
/// due, so it needs no timer or instance between firings.
///
/// ## Delivery semantics
///
/// - **At most one firing per schedule is handled at a time**, including across
///   registrations of the same name; different schedules may run concurrently.
/// - Firings due while the previous handler runs are skipped and counted in the next
///   delivery's `missed`.
/// - Undeliverable firings are skipped without storage or replay; `missed` counts them
///   only when the implementer can track them.
/// - A handler may request redelivery with `retry`; `id` identifies the firing, and
///   `attempt` counts its deliveries.
@since(version = 0.1.0)
interface handler {
    @since(version = 0.1.0)
    use types.{firing};

    /// A handler failure indicating whether redelivery may succeed.
    @since(version = 0.1.0)
    variant handler-error {
        /// Request redelivery after a temporary failure, such as an unavailable
        /// dependency, held lock, or exhausted quota.
        ///
        /// Retries use a delay and bounded attempt count; repeating schedules stop
        /// retrying once the next firing is due, including if it came due during the
        /// handler call.
        /// The next delivery counts a firing given up this way in `missed`.
        retry(option<string>),
        /// Stop retrying this firing and deliver future firings of a repeating schedule
        /// as usual.
        failed(option<string>),
        /// An unspecified failure, treated as `failed`.
        ///
        /// Implementers treat a call that cannot complete, because of a trap, deadline,
        /// or workload stopping mid-call, the same way.
        other(option<string>),
    }

    /// Handle one firing, returning `ok` on success.
    ///
    /// Errors do not cancel repeating schedules; use `scheduler.unregister` to stop
    /// them.
    /// A one-shot schedule ends after its firing and any retries, regardless of the
    /// result.
    ///
    /// Error details are diagnostic text and must not be matched.
    @since(version = 0.1.0)
    handle: async func(firing: firing) -> result<_, handler-error>;
}
