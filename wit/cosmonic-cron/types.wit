package cosmonic:cron@0.1.0;

/// Types shared by the `scheduler` and `handler` interfaces.
///
/// Time is spelled with `wasi:clocks@0.3.0` throughout rather than with types
/// of this package's own: a period is a `wasi:clocks/types.duration`, and a
/// point in time is a `wasi:clocks/system-clock.instant`.
@since(version = 0.1.0)
interface types {
    @since(version = 0.1.0)
    use wasi:clocks/types@0.3.0.{duration};
    @since(version = 0.1.0)
    use wasi:clocks/system-clock@0.3.0.{instant};

    /// The name of one schedule, unique within the caller's workload.
    ///
    /// 1 to 64 characters from ASCII letters, digits, `-`, `_` and `.`. The
    /// name is the only thing that ties a firing back to the schedule that
    /// produced it, so a component that holds several schedules tells them
    /// apart by name.
    @since(version = 0.1.0)
    type schedule-name = string;

    /// A calendar schedule: a crontab expression, and the time zone its fields
    /// are read in.
    ///
    /// # References
    ///
    /// - [POSIX crontab](https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html)
    /// - [IANA Time Zone Database](https://www.iana.org/time-zones)
    @since(version = 0.1.0)
    record cron-schedule {
        /// Five space-separated fields: minute (0-59), hour (0-23), day of
        /// month (1-31), month (1-12) and day of week (0-6, Sunday is 0).
        ///
        /// Each field is `*`, a number, a range (`1-5`) or a comma-separated
        /// list of those, as POSIX crontab specifies, plus the step suffix
        /// (`*/15`, `0-30/10`) and the English three-letter month and weekday
        /// names (`jan`, `mon`) that every common cron accepts. When both day
        /// fields are restricted the schedule fires when either matches, which
        /// is the POSIX rule.
        ///
        /// The finest schedule this spells is once a minute; use `interval`
        /// for anything faster. An implementer may accept more than this
        /// (`@hourly`, a seconds field), but an expression that stays inside
        /// it is portable, and one outside what the implementer accepts is
        /// refused with `invalid-schedule`.
        expression: string,
        /// The IANA time zone the fields are read in, such as
        /// `America/New_York`. `none` reads them in UTC.
        ///
        /// A zone with daylight saving has local times that never occur and
        /// local times that occur twice. What a schedule naming one of those
        /// does is up to the implementer; schedule in UTC where a skipped or
        /// repeated firing would matter.
        timezone: option<string>,
    }

    /// When a schedule fires.
    ///
    /// A `variant` with a trailing `other` rather than a closed set, because
    /// the kinds of schedule are the part of this package most likely to grow
    /// (a single future instant, a recurrence rule) and a WIT variant cannot
    /// gain a case without breaking every component built against it.
    @since(version = 0.1.0)
    variant schedule {
        /// At the wall-clock times a crontab expression matches.
        ///
        /// Firing times are read from a system clock, so they follow that
        /// clock when it is corrected.
        cron(cron-schedule),
        /// Repeatedly, one period apart, measured on a monotonic clock: the
        /// shape of a poll loop. The first firing is one period after the
        /// schedule takes effect, not immediately.
        ///
        /// The period is a fixed rate rather than a delay between runs: a
        /// handler that takes a third of the period still fires once per
        /// period. An implementer has a shortest period it permits, and
        /// refuses a shorter one with `invalid-schedule`.
        interval(duration),
        /// A kind of schedule this version does not name, spelled in the
        /// implementer's own syntax.
        ///
        /// An implementer that does not recognize the text refuses it with
        /// `unsupported`. An implementer also reports a schedule this way
        /// when it holds one that the caller's version of this type cannot
        /// express.
        other(string),
    }

    /// One schedule the implementer is holding for the caller's workload.
    @since(version = 0.1.0)
    record registration {
        name: schedule-name,
        schedule: schedule,
        /// Whether the schedule was declared for the workload rather than
        /// registered by it: `true` for one that came with the workload's
        /// grant, `false` for one a component created with
        /// `scheduler.register`.
        ///
        /// A declared schedule belongs to whoever deployed the workload. A
        /// component can see it and is called by it, but cannot replace or
        /// remove it.
        declared: bool,
    }

    /// One occasion on which a schedule came due, as delivered to `handler`.
    @since(version = 0.1.0)
    record firing {
        /// The schedule that came due.
        name: schedule-name,
        /// When this firing was due, which is earlier than when the handler
        /// runs. For a `cron` schedule this is the exact instant the
        /// expression matched, so it is stable across redeliveries and usable
        /// as an idempotency key together with `name`. For an `interval`
        /// schedule it is the system-clock reading when the period elapsed.
        scheduled-at: instant,
        /// How many firings of this schedule were skipped since the last one
        /// delivered, and so are represented by this one.
        ///
        /// A firing is skipped rather than queued when the previous firing of
        /// the same schedule is still being handled, when the workload could
        /// not be called, or when the implementer was not running. A handler
        /// that must account for every period reads this; one that only needs
        /// to run "about now" can ignore it.
        missed: u32,
        /// Which delivery of this firing this is: 1 the first time, and one
        /// more each time the handler answers `retry` and it is redelivered.
        attempt: u32,
    }

    /// Why a schedule could not be registered, removed or listed.
    @since(version = 0.1.0)
    variant schedule-error {
        /// The name is empty, too long, or uses a character outside the set
        /// `schedule-name` permits. Carries detail for a log.
        invalid-name(string),
        /// The schedule cannot be read or can never fire: a malformed crontab
        /// expression, an unknown time zone, a zero period, or a period
        /// shorter than the implementer permits. Carries detail for a log.
        invalid-schedule(string),
        /// The implementer does not provide this kind of schedule. Carries
        /// detail for a log.
        unsupported(string),
        /// The caller may not change this schedule: it was declared for the
        /// workload rather than registered by it, or the caller holds no
        /// grant to schedule at all.
        access-denied,
        /// The caller already holds as many registered schedules as the
        /// implementer permits. Remove one before adding another.
        limit-exceeded,
        /// Nothing in the caller's workload exports `handler`, so a firing
        /// would have nowhere to be delivered.
        no-handler,
        /// A failure not captured above. Implementers use this to extend the
        /// set without breaking existing callers; treat it as a generic
        /// failure. The detail is diagnostic only and not stable.
        other(option<string>),
    }
}
