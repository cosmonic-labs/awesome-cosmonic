package cosmonic:notifications@0.3.0;

/// Text is plain; providers may strip display controls and normalize empty labels.
interface types {
  /// What happens when the user activates an action or the notification body.
  variant action-target {
    /// Open a relative application route. Reject schemes, hosts, `..`, and a
    /// leading `//`. An unknown route only focuses the application.
    deep-link(string),
    /// Open an HTTP or HTTPS URL. Other schemes return invalid-argument.
    url(string),
    /// Return the response to the sender; the provider navigates nowhere.
    callback,
  }
  record action {
    /// Non-blank printable id of at most max-id-bytes, unique across actions
    /// and text input. Echoed in responses exactly as sent.
    id: string,
    label: string,
    target: action-target,
  }
  record text-input {
    /// Non-blank printable id of at most max-id-bytes, unique across actions
    /// and text input. Echoed in responses exactly as sent.
    id: string,
    label: string,
    placeholder: option<string>,
  }
  /// Presentation hint; unsupported urgency uses normal.
  enum urgency { low, normal, critical }
  record notification {
    /// Must contain a non-whitespace character.
    title: string,
    body: string,
    /// Presentation hint; see `supported-features.urgency`.
    urgency: urgency,
    /// Truncated to max-actions; the provider logs what it drops.
    actions: list<action>,
    /// Without inline-reply support, becomes an action with the same id, but
    /// only if actions are supported and a max-actions slot remains after the
    /// listed actions; the fallback button counts toward max-actions. Otherwise
    /// the provider drops the input and logs it.
    input: option<text-input>,
    /// Body-click target. None lets the embedding choose, which may be no
    /// navigation at all.
    default-target: option<action-target>,
    /// Trimmed, then used exactly as trimmed; blank means none and more than
    /// max-tag-bytes returns invalid-argument. Replaces the pending notification with the
    /// same tag in the same caller scope.
    tag: option<string>,
    /// Response deadline in ms; none or zero uses default-timeout-ms.
    /// Values above max-timeout-ms are clamped. Display lifetime is best effort.
    timeout-ms: option<u32>,
  }
  /// Opaque id, unique within the caller scope and never reused there.
  /// Ids remain valid across component instances.
  type notification-id = u64;
  /// A submitted inline reply.
  record text-reply {
    input-id: string,
    text: string,
  }
  /// The one terminal outcome of an accepted notification.
  variant response {
    /// The user activated the notification body.
    activated,
    /// The selected action id.
    action(string),
    /// The input id and submitted text.
    reply(text-reply),
    dismissed,
    /// Deadline, close, replacement, or orderly provider shutdown.
    expired,
  }
  /// A queued response, correlated by the id that `post` returned.
  record event {
    id: notification-id,
    response: response,
  }
  variant error-code {
    /// Permission or service policy forbids the operation, or the provider
    /// cannot identify the caller.
    access-denied,
    /// A rate or resource limit was reached.
    limit-exceeded,
    /// The service cannot deliver notifications now.
    unavailable,
    invalid-argument(string),
    /// The provider cannot adapt the request to its service.
    not-supported(string),
    /// Delivery failed; detail is diagnostic only.
    failed(string),
    /// An unclassified error; optional detail is diagnostic only.
    other(option<string>),
  }
  /// Effective behavior of the composed service, not its underlying platform.
  record supported-features {
    actions: bool,
    inline-reply: bool,
    urgency: bool,
    /// Providers can honor deep-link and url targets; otherwise they behave
    /// as callback.
    navigation: bool,
    /// Display may remain in a notification center until completion.
    persistent: bool,
    max-actions: u32,
    /// UTF-8 byte limits on display text; longer text is truncated at a
    /// character boundary.
    max-title-bytes: u32,
    max-body-bytes: u32,
    /// Applies to action labels, input labels, and placeholders.
    max-label-bytes: u32,
    /// UTF-8 byte limits on identifiers. Longer action and input ids, or a tag
    /// longer after trimming, return invalid-argument. Providers never truncate
    /// them, because that would break response correlation or make distinct
    /// notifications replace each other.
    max-id-bytes: u32,
    max-tag-bytes: u32,
    default-timeout-ms: u32,
    max-timeout-ms: u32,
    max-pull-wait-ms: u32,
    /// Overflow drops the oldest queued responses.
    max-queued-events: u32,
  }
  enum permission {
    granted,
    denied,
    prompt-required,
    /// The provider cannot determine permission.
    unknown,
  }
  /// Snapshot only; sending can still fail after this query succeeds.
  record service-status {
    available: bool,
    permission: permission,
  }
}
