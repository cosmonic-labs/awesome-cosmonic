package cosmonic:notifications@0.3.0;

/// Notification values shared by callers and providers. Display text is plain.
@since(version = 0.3.0)
interface types {
  @since(version = 0.3.0)
  use wasi:clocks/types@0.3.0.{duration};

  /// What happens when the user activates an action or the notification body.
  @since(version = 0.3.0)
  variant action-behavior {
    /// Open an application route. Reject schemes, hosts, `..`, and leading `//`.
    /// An unknown route only focuses the application. Selecting it also settles
    /// the notification as action(id), or activated for the body target.
    deep-link(string),
    /// Open an HTTP or HTTPS URL. Other schemes return invalid-argument.
    /// Selecting it also settles the notification like deep-link.
    url(string),
    /// Report the response without navigation. Use this for application-specific
    /// actions handled by the consumer.
    callback,
  }

  /// A labeled action offered to the user, usually rendered as a button.
  @since(version = 0.3.0)
  record notification-action {
    /// Nonblank printable id, unique across actions and input. Never trimmed.
    /// Accept at least 64 UTF-8 bytes; reject invalid or oversized ids with
    /// invalid-argument. Echo accepted ids exactly; never truncate them.
    id: string,
    /// Button text. Providers may normalize an empty label.
    label: string,
    /// Navigation or callback behavior when selected.
    behavior: action-behavior,
  }

  /// A request for inline text input; the provider chooses how to render it.
  @since(version = 0.3.0)
  record text-input {
    /// Same rules as `notification-action.id`.
    id: string,
    /// Input label. Providers may normalize an empty label.
    label: string,
    /// Hint shown in an empty input; none requests no hint.
    placeholder: option<string>,
  }

  /// Presentation hints matching the freedesktop urgency levels.
  /// Unsupported urgency uses normal; it does not alter the response deadline.
  @since(version = 0.3.0)
  enum urgency {
    /// Background information.
    low,
    /// Ordinary information needing attention.
    normal,
    /// Information needing immediate attention.
    critical,
  }

  /// Content, interaction targets, and response deadline for one notification.
  @since(version = 0.3.0)
  record notification {
    /// Must contain a non-whitespace character. Truncate oversized display
    /// text at a character boundary; providers may strip display controls.
    title: string,
    /// Supporting display text; may be empty. Same display rules as title.
    body: string,
    /// Presentation hint; see `supported-feature.urgency`.
    urgency: urgency,
    /// Truncated to the limit in supported-feature.actions (zero if absent);
    /// the provider logs what it drops.
    actions: list<notification-action>,
    /// With inline reply, the input uses no action slot. Without it, use a
    /// same-id callback button if actions are supported and an action slot
    /// remains after the listed actions; the button returns action(id) with no
    /// text. Listed actions keep precedence: the fallback button never displaces
    /// one, so a caller that needs a reply checks get-features or sends fewer
    /// actions. If no slot remains or actions are unsupported, return
    /// not-supported rather than accept a reply that cannot arrive.
    input: option<text-input>,
    /// Body-click behavior. None lets the embedding choose, including no navigation.
    default-behavior: option<action-behavior>,
    /// Caller-chosen replacement key, such as "build-status", not a notification id.
    /// Sending the same tag in this caller scope closes the previous pending
    /// notification and returns a new id for its replacement. Completed results
    /// keep their original ids and outcomes. None disables replacement.
    /// Unlike ids, a tag is only compared, so trim it before validation; blank
    /// returns invalid-argument. Accept at least 64 UTF-8 bytes; reject
    /// oversized tags without truncation.
    tag: option<string>,
    /// Response deadline after acceptance, in nanoseconds. None uses the
    /// provider's default; zero expires immediately. Clamp to the provider's
    /// maximum. The default and maximum are finite. Native display lifetime is
    /// best effort.
    timeout-ns: option<duration>,
  }

  /// Opaque id, unique within the caller scope and never reused there.
  /// Ids remain valid across component instances.
  @since(version = 0.3.0)
  type notification-id = u64;

  /// A submitted inline reply.
  @since(version = 0.3.0)
  record text-reply {
    /// The input id exactly as sent.
    input-id: string,
    /// User-submitted text; may be empty.
    text: string,
  }

  /// A terminal outcome reported by the notification service.
  @since(version = 0.3.0)
  variant response {
    /// The user activated the notification body.
    activated,
    /// The selected action id.
    action(string),
    /// The input id and submitted text.
    reply(text-reply),
    /// The user dismissed it; reported only with dismissal support.
    dismissed,
    /// The response deadline passed, or dismissal could not be observed. Without
    /// dismissal support it may hide an explicit dismissal, so do not resend
    /// automatically.
    expired,
    /// Withdrawn by close, replaced by a tag, or ended by orderly shutdown when
    /// the provider can still deliver. It reflects no user decision, so the
    /// caller may resend.
    closed,
    /// Another terminal outcome; detail is diagnostic only. Do not assume
    /// user activation or retry automatically. Providers use this case for
    /// outcomes outside the listed set without adding a new discriminant.
    other(option<string>),
  }

  /// An accepted notification's queued outcome or delivery failure.
  @since(version = 0.3.0)
  record event {
    /// The id returned by send.
    id: notification-id,
    /// The same result that would have resolved sent.response.
    response: result<response, error-code>,
  }

  /// Operation or delivery failures. Detail strings are diagnostic only.
  @since(version = 0.3.0)
  variant error-code {
    /// Permission or caller policy forbids access, or wiring lacks a caller scope.
    access-denied,
    /// A rate or resource limit was reached. Retry after backoff or resource release.
    limit-exceeded,
    /// The service cannot deliver now, including declined authorization.
    unavailable,
    /// A malformed or unacceptable value, including an invalid id or tag.
    invalid-argument(string),
    /// The provider cannot adapt the request to its service.
    not-supported(string),
    /// A delivery or subscription failed after the service attempted it.
    failed(string),
    /// An unclassified failure with a nonblank diagnostic description.
    /// Use a generic description when the service supplies no details.
    other(string),
  }

  /// A supported interaction or presentation feature. Absence means unsupported.
  @since(version = 0.3.0)
  variant supported-feature {
    /// Buttons are supported, up to the given limit (1 through 8). Fallback
    /// reply buttons count toward this limit; inline reply controls do not.
    actions(u32),
    /// Text input can produce reply rather than a fallback action.
    inline-reply,
    /// The service honors urgency hints.
    urgency,
    /// User dismissal can be observed. Enable required platform opt-ins for
    /// every notification; otherwise dismissed notifications expire.
    dismissal,
    /// The service honors deep-link and url behaviors under embedding policy;
    /// otherwise they act as callback.
    navigation,
    /// A provider extension, identified by a nonblank namespaced name such as
    /// "example:badge". Callers ignore names they do not understand. Extensions
    /// do not change the behavior of the standard features above.
    other(string),
 }
}
