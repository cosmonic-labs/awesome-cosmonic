package cosmonic:notifications@0.3.0;

/// The provider identifies the caller through trusted wiring and scopes ids,
/// tags, rate budget, and queued responses to the calling workload. Short-lived
/// components in one workload share that scope across invocations.
interface notifier {
  use types.{notification, notification-id, response, error-code,
             supported-features, service-status};
  /// Side-effect-free discovery; never displays UI or requests permission.
  features: async func() -> supported-features;
  /// Side-effect-free availability and permission snapshot.
  status: async func() -> service-status;
  /// Accepts delivery and returns an id; does not guarantee visibility. The
  /// terminal response is queued for `events.pull`, even from a later instance.
  post: async func(notification: notification) -> result<notification-id, error-code>;
  /// Waits for one terminal response or the bounded deadline; never queues it.
  /// Cancellation may lose the response.
  request: async func(notification: notification) -> result<response, error-code>;
  /// Resolves a pending id as expired. Unknown or completed ids are a no-op.
  close: async func(id: notification-id) -> result<_, error-code>;
}

/// Responses to posted notifications, queued per workload across invocations.
interface events {
  use types.{event, error-code};
  /// Removes queued events at most once; zero polls, waits are clamped to
  /// max-pull-wait-ms. Live providers settle accepted notifications once.
  /// Overflow drops the oldest events; abrupt provider loss can prevent
  /// delivery. No durable delivery is promised.
  pull: async func(max-wait-ms: u32) -> result<list<event>, error-code>;
}
