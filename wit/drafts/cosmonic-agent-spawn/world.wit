/// Sub-agents and host-mediated tools for sandboxed agents. Not published;
/// for discussion. See README.md.
package cosmonic:agent@0.5.0;

/// An agent that may spawn sub-agents and read their final replies.
@since(version = 0.5.0)
world spawner {
    include cosmonic:agent/agent@0.3.0;

    import spawn;
}

/// An agent that may ask which tools are available to it.
@since(version = 0.5.0)
world tool-discoverer {
    include cosmonic:agent/agent@0.3.0;

    import tool-discovery;
}

/// An agent that may load tools into itself while it runs. Loading is a
/// separate power from spawning and is never implied by it.
@since(version = 0.5.0)
world tool-loader {
    include tool-discoverer;

    import tool-loading;
}

/// A top-level harness: every power in this package.
@since(version = 0.5.0)
world harness {
    include spawner;
    include tool-loader;
}

/// An agent a host can hand runs to in process: the world a spawned child
/// targets.
@since(version = 0.5.0)
world runnable-agent {
    include cosmonic:agent/agent@0.3.0;

    export runnable;
}

/// One tool component with its own grants.
@since(version = 0.5.0)
world tool-provider {
    export tool-workload;
}

/// An implementer of `spawn`, such as a host plugin or a test double.
@since(version = 0.5.0)
world spawn-provider {
    export spawn;
}

/// An implementer of tool discovery and loading: the host side of tool discovery and loading.
@since(version = 0.5.0)
world tool-provider-host {
    export tool-discovery;
    export tool-loading;
}
