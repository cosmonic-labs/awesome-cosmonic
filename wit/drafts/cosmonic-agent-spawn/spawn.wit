package cosmonic:agent@0.4.0-draft;

/// DRAFT for discussion. Not published, not a contract; see DESIGN-NOTES.md.
///
/// Spawn a sub-agent with a declared set of tools, give it turns, and get
/// back its final replies. Scoped to agents on purpose: a caller describes an
/// agent, its tools and their grants, not an arbitrary workload. How the host
/// fulfils a spawn (a wasmCloud workload today) is not part of the contract.
///
/// The host sees the caller. The implementing plugin receives the caller's
/// workload definition from the host: its components, interfaces, allowed
/// hosts, volumes, secret names, and model bindings. Policy runs on the
/// semantic request here and again when the host admits what it builds.
///
/// Reach. A request's read reach is the union, over the agent and every tool,
/// of its read grants: volumes, secrets, interfaces the host classifies as
/// reading, and the model binding. Its egress reach is the union of allowed
/// hosts and interfaces the host classifies as writing. A read-write volume
/// counts both ways.
///
/// Ceiling. By default the child's read reach and egress reach must each fit
/// inside the caller's. Within that ceiling, results flowing up to the caller
/// are not a leak: the caller could have read the same data itself.
///
/// Attenuation. A caller may request more than the ceiling but cannot grant
/// it. The host is the sole grantor, by policy or a person, and returns
/// needs-approval. An approval is an explicit declassification: it is bound
/// to a digest over the caller's identity, the whole request, and its output
/// and limits, and its detail says what returns to whom. Turns the caller
/// sends are content that can reach the child's egress; an approval of
/// egress beyond the ceiling says so too.
///
/// The final reply is a declassification channel by nature, and redaction is
/// not a security boundary, because a model can paraphrase anything it read.
/// So nothing else the caller sees carries child-authored text: progress,
/// errors, and reasons are host-authored. The child's journal is observable
/// only on the host's own API, by a person or the auditor, never by the caller.
///
/// Credentials never pass through this interface. Models and secrets are
/// named; the host resolves them and keeps values out of every agent's memory.
interface spawn {
    use cosmonic:agent/inference-types@0.3.0.{json, attachment, opaque-block, usage, user-message};

    /// A component image pinned by content digest. A moving tag cannot change
    /// what was approved.
    record component-ref {
        /// An OCI reference such as `ghcr.io/acme/agents/coder:1.2.0`.
        image: string,
        /// `sha256:<hex>`. Authoritative; the tag in `image` is for display.
        digest: string,
    }

    /// A host volume mounted into one component. Read-write counts toward
    /// both read and egress reach.
    record volume-mount {
        /// The name of a volume the host knows. Never a host path.
        volume: string,
        mount-path: string,
        read-only: bool,
    }

    /// A host interface granted to one component. The host, not the request,
    /// classifies it as reading, writing, or both.
    record interface-grant {
        /// Fully qualified interface name with version, such as
        /// `wasi:keyvalue/store@0.2.0`.
        name: string,
        /// Interface-specific configuration, such as a bucket or topic.
        config: list<tuple<string, string>>,
    }

    /// What one component may touch. Empty grants nothing; nothing is inherited.
    record grants {
        allowed-hosts: list<string>,
        volumes: list<volume-mount>,
        interfaces: list<interface-grant>,
        /// Secret names the host injects into this component. Names only.
        secrets: list<string>,
    }

    /// A tool for the child: a component with its own grants.
    record tool-request {
        /// Unique within the request. Used for routing, display, and audit.
        name: string,
        /// A component exporting `cosmonic:agent/tools`.
        component: component-ref,
        grants: grants,
    }

    /// What may come back to the caller. Covered by the approval digest.
    record output-spec {
        /// JSON Schema the host validates `structured` against. None means
        /// reply parts only.
        schema: option<json>,
        /// Ceiling on the encoded outcome of one turn, in bytes.
        max-bytes: u32,
    }

    /// Bounds on the child's lifetime work. Covered by the approval digest.
    /// None takes the host's default, which policy may cap.
    record limits {
        max-turns: option<u32>,
        max-tokens: option<u64>,
        /// Wall-clock budget from spawn, in milliseconds.
        deadline-ms: option<u64>,
    }

    /// Everything needed to start a sub-agent. Declarative: the tool set is
    /// fixed for the agent's lifetime.
    record spawn-request {
        /// A component targeting the `agent` world.
        agent: component-ref,
        /// A host-level inference binding by name, as `models.open` takes it.
        /// Counts toward read reach like any other grant.
        model: string,
        /// The child's instructions.
        instructions: string,
        /// Hosts the agent component itself may reach. Tools carry their own.
        allowed-hosts: list<string>,
        tools: list<tool-request>,
        output: output-spec,
        limits: limits,
        /// For logs, audit, and display. Never policy input.
        labels: list<tuple<string, string>>,
    }

    /// A request that needs a grantor's decision before it can run.
    record approval {
        /// Host-issued id, to correlate with the host's approval UI and audit log.
        id: string,
        /// Digest over the caller's identity, the request, its output, and limits.
        request-digest: string,
        /// Host-authored. States what is declassified, for example "results of
        /// this agent (schema S, at most N bytes) return to <caller>".
        detail: string,
    }

    record over-limit {
        /// Host-authored scope, such as agents, depth, or memory.
        what: string,
        limit: option<u64>,
    }

    /// Why a spawn did not start an agent. All strings are host-authored.
    variant spawn-error {
        /// A policy or a person refused.
        denied(string),
        /// Beyond the ceiling and sent to a grantor. Resend the identical
        /// request once approved; a changed request is a new request.
        needs-approval(approval),
        over-limit(over-limit),
        /// Malformed: a missing digest, a duplicate tool name, an unknown
        /// binding, a component that does not target the right world.
        invalid-request(string),
        /// The host could not serve the call; the detail is for logs.
        unavailable(string),
        other(string),
    }

    /// A final reply part. No tool use, reasoning, or continuation data.
    variant reply-part {
        text(string),
        attachment(attachment),
        other(opaque-block),
    }

    /// Why a turn ended. Host-authored.
    variant finish {
        /// The agent ended its reply.
        done,
        max-turns,
        max-tokens,
        deadline,
        other(string),
    }

    /// The result of one turn: the final reply and what it cost.
    record turn-outcome {
        reply: list<reply-part>,
        /// Validated against `output.schema`; present only when one was set.
        structured: option<json>,
        usage: usage,
        /// Model calls made in this turn.
        steps: u32,
        tool-calls: u32,
        finish: finish,
    }

    /// Cumulative counters across this turn.
    record step-counts {
        steps: u32,
        tool-calls: u32,
        usage: usage,
    }

    /// Why a turn is paused. Host-authored codes.
    variant blocked-reason {
        /// A tool call waits on a person or the auditor.
        tool-approval,
        /// Policy holds the outcome until a person or the auditor releases it.
        outcome-release,
        other(string),
    }

    /// Contentless progress. The host coalesces it and never blocks on an
    /// unread stream.
    variant progress {
        working,
        blocked(blocked-reason),
        steps(step-counts),
        other(string),
    }

    /// Why a turn failed. All strings are host-authored, never the child's.
    variant turn-error {
        /// A turn is already in progress. One turn at a time.
        busy,
        /// The turn was cancelled by dropping its progress stream.
        cancelled,
        /// The agent's limits are spent; it takes no more turns.
        exhausted(finish),
        /// The reply failed `output.schema` or exceeded `output.max-bytes`.
        output-rejected(string),
        /// A person or the auditor declined to release the outcome.
        withheld,
        /// The child failed. A host-authored code; details are on the host API.
        failed(string),
        unavailable(string),
        other(string),
    }

    /// Progress frames followed by the outcome. Dropping the stream cancels
    /// the turn; the agent stays idle and can take another.
    type turn = tuple<stream<progress>, future<result<turn-outcome, turn-error>>>;

    /// A spawned agent, owned by its caller. Dropping the handle ends the
    /// child and releases everything the host started for it.
    resource agent {
        /// Start one turn. Resolves when the host accepts it.
        send: async func(turn: user-message) -> result<turn, turn-error>;
    }

    /// Check the request against policy and start the agent. Resolves once
    /// accepted, not once its components are running.
    spawn: async func(request: spawn-request) -> result<agent, spawn-error>;
}
