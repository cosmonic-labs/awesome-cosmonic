package cosmonic:agent@0.4.0-draft;

/// DRAFT for discussion. Not published, not a contract; see DESIGN-NOTES.md.
///
/// Types shared by `spawn` and `spawn-sealed`. Importing this interface
/// grants nothing: the powers live in those two interfaces.
///
/// The contract below binds the implementer of `spawn` or `spawn-sealed`,
/// whatever it is: the native spawn plugin, a policy wrapper in front of it,
/// or a test double. "The caller" is the component the import is bound to.
///
/// Reach. A request's read reach is the union, over the agent and every
/// tool, of its read grants: volumes, secrets, interfaces the implementer
/// classifies as reading, and the model binding. Its egress reach is the
/// union of allowed hosts and interfaces the implementer classifies as
/// writing. A read-write volume counts both ways.
///
/// Ceiling. By default the child's read reach and egress reach must each fit
/// inside the caller's. Within that ceiling, results flowing up are not a
/// leak: the caller could have read the same data itself.
///
/// Attenuation. A caller may request more than the ceiling but cannot grant
/// it. The implementer is the sole grantor, by policy or a person, and
/// returns `needs-approval`. An approval is an explicit declassification
/// bound to a digest over the caller's identity and the whole request.
/// Content the caller sends down can reach the child's egress; an approval
/// of egress beyond the ceiling says so too.
///
/// Authorship. A model can paraphrase anything it read, so redaction is not
/// a security boundary and an open agent's final reply is a declassification
/// channel by nature. Nothing else the caller sees carries child-authored
/// text: progress, errors, and reasons are implementer-authored, and every
/// detail string is diagnostic only, not stable, and not for branching on.
/// The child's journal is never observable through these interfaces.
///
/// Credentials never pass through these interfaces. Models and secrets are
/// named; the implementer resolves them and keeps values out of every
/// agent's memory.
///
/// # References
/// - OCI image digests: https://github.com/opencontainers/image-spec/blob/main/descriptor.md#digests
/// - JSON Schema: https://json-schema.org/specification
@since(version = 0.4.0-draft)
interface spawn-types {
    use wasi:clocks/types@0.3.0.{duration};
    use cosmonic:agent/inference-types@0.3.0.{json, attachment, opaque-block, usage};

    /// A component image pinned by content digest, so a moving tag cannot
    /// change what was approved.
    record component-ref {
        /// An OCI reference such as `ghcr.io/acme/agents/coder:1.2.0`. For
        /// display; `digest` is authoritative.
        image: string,
        /// An OCI digest, `sha256:<hex>`.
        digest: string,
    }

    /// A named volume mounted into one component. Read-write counts toward
    /// both read and egress reach.
    record volume-mount {
        /// The name of a volume the implementer knows. Never a host path.
        volume: string,
        /// Where the component sees the volume.
        mount-path: string,
        /// True mounts the volume read-only.
        read-only: bool,
    }

    /// An interface granted to one component. The implementer, not the
    /// request, classifies it as reading, writing, or both.
    record interface-grant {
        /// Fully qualified interface name with version, such as
        /// `wasi:keyvalue/store@0.2.0`.
        name: string,
        /// Interface-specific configuration, such as a bucket or topic.
        config: list<tuple<string, string>>,
    }

    /// What one component may touch. Empty grants nothing; nothing is
    /// inherited from the caller.
    record grants {
        /// Hosts this component may reach.
        allowed-hosts: list<string>,
        /// Volumes mounted into this component.
        volumes: list<volume-mount>,
        /// Interfaces this component may import.
        interfaces: list<interface-grant>,
        /// Secret names the implementer injects into this component. Names
        /// only, never values.
        secrets: list<string>,
    }

    /// A tool for the child: a component with its own grants.
    record tool-request {
        /// Unique within the request. Used for routing, display, and audit.
        name: string,
        /// A component exporting `cosmonic:agent/tools@0.3.0`.
        component: component-ref,
        /// What this tool component may touch.
        grants: grants,
    }

    /// What may come back to the caller, or reach a sealed agent's sink.
    /// Covered by the approval digest.
    record output-spec {
        /// JSON Schema that `structured` must satisfy. None means reply
        /// parts only.
        schema: option<json>,
        /// Ceiling on the encoded outcome of one turn, in bytes.
        max-bytes: u32,
    }

    /// Bounds on the child's lifetime work. Covered by the approval digest.
    /// None takes the implementer's default, which policy may cap.
    record limits {
        /// Turns the child may take.
        max-turns: option<u32>,
        /// Tokens the child may spend across all turns.
        max-tokens: option<u64>,
        /// Wall-clock budget, measured from spawn.
        deadline: option<duration>,
    }

    /// Everything needed to start a sub-agent. Declarative: the tool set is
    /// fixed for the agent's lifetime. Construction is lenient; `spawn` and
    /// `spawn-sealed` validate and return `invalid-request`.
    record spawn-request {
        /// A component targeting the `cosmonic:agent/agent@0.3.0` world.
        agent: component-ref,
        /// An inference binding name, as `models.open` takes it, resolved in
        /// the caller's scope. Counts toward read reach like any other grant.
        model: string,
        /// The child's instructions.
        instructions: string,
        /// Hosts the agent component itself may reach. Tools carry their own.
        allowed-hosts: list<string>,
        /// The child's tools. Names must be unique.
        tools: list<tool-request>,
        /// What may come back, and how much.
        output: output-spec,
        /// Bounds on the child's lifetime work.
        limits: limits,
        /// For logs, audit, and display. Never policy input.
        labels: list<tuple<string, string>>,
    }

    /// A grantor's decision on a request that needed approval.
    variant decision {
        /// Granted. Resend the identical request; it is admitted.
        granted,
        /// Refused, with an implementer-authored reason.
        refused(string),
        /// No decision before the approval expired.
        expired,
        /// A decision not captured above. Treat as refused.
        other(option<string>),
    }

    /// A request beyond the caller's ceiling, sent to a grantor.
    record approval {
        /// Implementer-issued id, to correlate with the approval UI and audit log.
        id: string,
        /// `sha256:<hex>` over the caller's identity and the whole request,
        /// including `output` and `limits` (and `sink`, for a sealed spawn).
        /// A changed request has a different digest and is a new request.
        request-digest: string,
        /// Implementer-authored. States what is declassified, for example
        /// "results of this agent (schema S, at most N bytes) return to <caller>".
        detail: string,
        /// Resolves when the grantor decides. Dropping it withdraws a request
        /// that is still pending.
        decision: future<decision>,
    }

    /// Which implementer limit a spawn would exceed.
    variant limit-scope {
        /// Agents running at once for this caller. May clear when one ends.
        concurrent-agents,
        /// Nesting depth of spawned agents. Does not clear.
        depth,
        /// Memory the implementer reserves for the child.
        memory,
        /// A scope not captured above.
        other(option<string>),
    }

    /// An implementer limit a spawn would exceed.
    record over-limit {
        /// Which limit.
        scope: limit-scope,
        /// The limit's value, where the implementer reports it.
        limit: option<u64>,
    }

    /// Why a spawn did not start an agent. Detail strings are
    /// implementer-authored and diagnostic only.
    variant spawn-error {
        /// A policy or a person refused. The capability is partially granted:
        /// a different request may succeed.
        access-denied(string),
        /// Beyond the ceiling and sent to a grantor. Await `decision`, then
        /// resend the identical request.
        needs-approval(approval),
        /// An implementer limit would be exceeded.
        over-limit(over-limit),
        /// Malformed: a malformed digest, a duplicate tool name, an unknown
        /// binding, a component that does not target the right world.
        invalid-request(string),
        /// The implementer could not serve the call. Retry may succeed.
        unavailable(string),
        /// A failure not captured above. Treat as permanent.
        other(option<string>),
    }

    /// A final reply part. No tool use, reasoning, or continuation data.
    variant reply-part {
        /// Reply text.
        text(string),
        /// An attachment the child produced.
        attachment(attachment),
        /// A part kind not captured above, passed through unchanged.
        other(opaque-block),
    }

    /// Why a turn ended. Implementer-authored.
    variant finish {
        /// The agent ended its reply.
        done,
        /// `limits.max-turns` was reached.
        max-turns,
        /// `limits.max-tokens` was reached.
        max-tokens,
        /// `limits.deadline` passed.
        deadline,
        /// A reason not captured above.
        other(option<string>),
    }

    /// Counters for one turn.
    record step-counts {
        /// Model calls made.
        steps: u32,
        /// Tool calls made.
        tool-calls: u32,
        /// Token usage. None in a field means unreported.
        usage: usage,
    }

    /// Why a turn is paused. Implementer-authored.
    variant blocked-reason {
        /// A tool call waits on a person or the auditor.
        tool-approval,
        /// Policy holds the outcome until a person or the auditor releases it.
        outcome-release,
        /// A reason not captured above.
        other(option<string>),
    }

    /// Contentless progress. The implementer coalesces frames and never
    /// blocks on an unread stream.
    variant progress {
        /// The child is working.
        working,
        /// The turn is paused.
        blocked(blocked-reason),
        /// Cumulative counters for this turn so far.
        steps(step-counts),
        /// A frame not captured above. Safe to ignore.
        other(option<string>),
    }

    /// Why a turn failed after it started. Detail strings are
    /// implementer-authored, never the child's, and diagnostic only.
    variant turn-error {
        /// The caller dropped the progress stream or the agent.
        cancelled,
        /// The outcome failed `output.schema` or exceeded `output.max-bytes`.
        output-rejected(string),
        /// A person or the auditor declined to release the outcome. Open
        /// agents only.
        withheld,
        /// The child failed. Details are on the observation path, not here.
        failed(string),
        /// The implementer could not finish serving the turn.
        unavailable(string),
        /// A failure not captured above. Treat as permanent.
        other(option<string>),
    }
}

/// DRAFT. The caller may spawn an open sub-agent and read its final replies,
/// within the ceiling in `spawn-types`.
@since(version = 0.4.0-draft)
interface spawn {
    use cosmonic:agent/inference-types@0.3.0.{json, user-message};
    use spawn-types.{
        spawn-request, spawn-error, reply-part, finish, step-counts, progress, turn-error,
    };

    /// The result of one turn: the final reply and what it cost.
    record turn-outcome {
        /// Final reply parts, in order.
        reply: list<reply-part>,
        /// Satisfies `output.schema`; present only when one was set.
        structured: option<json>,
        /// What the turn cost.
        counts: step-counts,
        /// Why the turn ended.
        finish: finish,
    }

    /// Why `send` did not start a turn.
    variant send-error {
        /// A turn is already in progress. One turn at a time.
        busy,
        /// The agent's limits are spent; it takes no more turns. Carries the
        /// limit that was reached.
        exhausted(finish),
        /// The implementer could not accept the turn. Retry may succeed.
        unavailable(string),
        /// A failure not captured above. Treat as permanent.
        other(option<string>),
    }

    /// Progress frames, then the outcome. The stream closes before the
    /// outcome resolves; a closed stream alone does not mean success.
    /// The outcome can be awaited without draining the stream. Dropping the
    /// stream cancels the turn: the outcome resolves to `cancelled` and may be
    /// dropped too, and the agent stays idle for another turn.
    type turn = tuple<stream<progress>, future<result<turn-outcome, turn-error>>>;

    /// A spawned agent, owned by its caller. Dropping the handle ends the
    /// child, cancels a turn in progress, and releases everything the
    /// implementer started for it.
    resource agent {
        /// Start one turn. Resolves when the implementer accepts it, not when
        /// the turn ends. While a turn is in progress, returns `busy`.
        send: async func(message: user-message) -> result<turn, send-error>;
    }

    /// Check the request against the ceiling and policy, and start the agent.
    /// Resolves once accepted, not once its components are running; a child
    /// that fails to start reports it on its first turn.
    spawn: async func(request: spawn-request) -> result<agent, spawn-error>;
}

/// DRAFT. The caller may spawn a sealed agent that returns nothing but
/// progress and a finish code; its results go to an implementer-named sink.
///
/// For privileged workers whose results the caller must never see. The
/// implementer enforces, on top of `spawn-types`:
/// - the sink is not one the caller can read;
/// - the child's writable reach does not overlap the caller's readable reach;
/// - child and caller use distinct credentials and egress identities.
/// Residual risk, stated plainly: a sealed child and its caller can still
/// signal each other through an external service both can reach, and through
/// timing. Sealing narrows the channel; it does not close every covert one.
@since(version = 0.4.0-draft)
interface spawn-sealed {
    use cosmonic:agent/inference-types@0.3.0.{user-message};
    use spawn-types.{spawn-request, spawn-error, finish, step-counts, progress, turn-error};

    /// Where a sealed agent's results go. Names only destinations the
    /// implementer knows; the caller cannot name an address, a path, or itself.
    variant sink {
        /// The person who owns the caller's workload, through the implementer's UI.
        person,
        /// The approval queue, for a person or the auditor to release.
        approval-queue,
        /// A named volume. Rejected if the caller can read it.
        volume(string),
        /// An implementer-defined sink, by name.
        other(string),
    }

    /// How a sealed run ended. No reply and no structured output.
    record sealed-outcome {
        /// Coarsened counters. Usage is reported as unreported (none).
        counts: step-counts,
        /// Why the run ended. Results went to the sink.
        finish: finish,
    }

    /// Progress frames, then the outcome. Dropping the stream cancels the run
    /// and ends the child; the outcome resolves to `cancelled`.
    type sealed-run = tuple<stream<progress>, future<result<sealed-outcome, turn-error>>>;

    /// Check the request against the sealed rules and policy, and run the
    /// agent on one task. The request's `output` limits what reaches the
    /// sink, not the caller. The approval digest also covers `sink`.
    spawn-sealed: async func(
        request: spawn-request,
        sink: sink,
        task: user-message,
    ) -> result<sealed-run, spawn-error>;
}
