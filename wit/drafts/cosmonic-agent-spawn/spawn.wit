package cosmonic:agent@0.5.0;

/// The caller may spawn an open sub-agent and read its final replies, within
/// the ceiling stated on `spawn-types`. Not published; for discussion.
@since(version = 0.5.0)
interface spawn {
    use cosmonic:agent/inference-types@0.3.0.{user-message};
    use spawn-types.{spawn-request, admission-error, finish, started-run};

    /// Why `run` did not start a run. In every case nothing reached the child.
    variant start-error {
        /// A run is already in progress. One run at a time.
        busy,
        /// The agent's limits are spent; it takes no more runs. Carries the
        /// limit that was reached.
        exhausted(finish),
        /// The implementer could not accept the run. Retry may succeed.
        unavailable(string),
        /// A failure not captured above. Treat as permanent.
        other(option<string>),
    }

    /// A spawned agent, owned by its caller and scoped to the caller's
    /// store. Dropping the handle ends the child, cancels a run in progress,
    /// and releases everything the implementer started for it. The
    /// implementer does the same when the caller's store ends without
    /// dropping the handle (a trap, or a handle that was never dropped), so a
    /// child cannot outlive its caller. A caller that gets a fresh store per
    /// request therefore cannot keep a child across its own requests.
    resource agent {
        /// Start one run: hand the child a message and let it work until it
        /// replies or a limit stops it. Resolves when the implementer accepts
        /// the run, not when it ends. While a run is in progress, returns
        /// `busy`, and keeps returning `busy` after a cancellation until the
        /// child has actually stopped, so two runs never overlap inside the
        /// child.
        run: async func(message: user-message) -> result<started-run, start-error>;
    }

    /// Check the request against the ceiling and policy, and start the agent.
    /// Resolves once accepted, not once its components are running; a child
    /// that fails to start reports it on its first run.
    spawn: async func(request: spawn-request) -> result<agent, admission-error>;
}
