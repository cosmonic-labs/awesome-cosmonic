package cosmonic:agent-spawn@0.1.0;

/// The caller may spawn a confined agent: one run whose results go to an
/// implementer-named sink, never to the caller. The caller gets progress and
/// a finish code, nothing else. Not published; for discussion.
///
/// The name follows Lampson's confinement problem (1973): a program is
/// confined when it cannot pass what it learned to anyone but its owner's
/// chosen recipients. Confinement here is partial, as Lampson's was.
///
/// For privileged workers whose results the caller must never see. The
/// implementer enforces, on top of the rules stated on `types`:
/// - the sink is not one the caller can read;
/// - the child's writable reach does not overlap the caller's readable reach;
/// - child and caller use distinct credentials and egress identities.
/// Residual risk, stated plainly: a confined child and its caller can still
/// signal each other through an external service both can reach, and through
/// timing. Confinement narrows the channel; it does not close every covert
/// one.
@since(version = 0.1.0)
interface spawn-confined {
    use cosmonic:agent/inference-types@0.3.0.{user-message};
    use types.{spawn-request, admission-error, finish, progress, run-error};

    /// Where a confined agent's results go. Names only destinations the
    /// implementer knows; the caller cannot name an address, a path, or itself.
    variant sink {
        /// The person who owns the caller's workload, through the implementer's UI.
        person,
        /// The approval queue, for a person or the auditor to release.
        approval-queue,
        /// A named volume. Rejected if the caller can read it.
        volume(string),
        /// An implementer-defined sink, by name.
        other(string),
    }

    /// How a confined run ended. No reply, no structured output, and no
    /// counts, since every count is a channel the child can steer.
    record confined-outcome {
        /// Why the run ended. Results went to the sink.
        finish: finish,
    }

    /// Progress frames, then the outcome. A confined run's stream carries
    /// only `working` and `blocked`, never `steps`. Its errors carry no detail
    /// that depends on the child's output: `output-rejected` never says by
    /// how much. Dropping the stream requests cancellation and ends the
    /// child; the outcome resolves to `cancelled` unless an outcome was
    /// already recorded. After a cancellation the sink may already hold part
    /// of the results, and the child's effects are not rolled back.
    type confined-run = tuple<stream<progress>, future<result<confined-outcome, run-error>>>;

    /// Check the request against the confinement rules and policy, and run
    /// the agent on one task. The request's `output` limits what reaches the
    /// sink, not the caller. The approval digest also covers `sink`.
    spawn-confined: async func(
        request: spawn-request,
        sink: sink,
        task: user-message,
    ) -> result<confined-run, admission-error>;
}
