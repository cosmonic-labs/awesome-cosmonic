package cosmonic:agent@0.4.0;

/// Tool discovery and calls. The same interface is imported by an agent and
/// exported by a tool provider, so a provider links directly to an agent or
/// sits behind a host that lists and dispatches across several providers.
interface tools {
    use inference-types.{tool-call};
    use tool-types.{tool-def, tool-response, call-error};

    /// All tools offered by this provider.
    %list: async func() -> list<tool-def>;

    /// Run a tool call. Its id correlates execution with the requesting turn.
    /// Retries reuse the same id and arguments; providers supporting repeat
    /// detection must reject the same id with different arguments.
    /// Retry an unknown outcome only with trusted repeat detection for this id.
    /// Dropping the pending call requests cooperative cancellation and may return
    /// no result. Without a terminal response, treat its effects as unknown.
    call: async func(request: tool-call) -> result<tool-response, call-error>;
}
