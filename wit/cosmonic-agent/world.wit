/// Inference, authorized model access, tools, and durable agent sessions.
package cosmonic:agent@0.4.0;

/// A provider owns the model resources used by its inference interfaces.
world inference-provider {
    export inference-types;
    export model-admin;
    export chat;
    export embeddings;
}

/// A trusted serving component, such as an OpenAI-compatible server.
world inference-client {
    import inference-types;
    import model-admin;
    import chat;
    import embeddings;
}

/// A provider that only serves chat.
world chat-provider {
    export inference-types;
    export model-admin;
    export chat;
}

/// A provider that only serves embeddings.
world embeddings-provider {
    export inference-types;
    export model-admin;
    export embeddings;
}

/// A sandboxed agent acquires models through workload-scoped aliases.
/// Model administration, credentials, and network grants belong to the host.
/// Notifications require an explicit cosmonic:notifications import and provider grant.
world agent {
    import inference-types;
    import models;
    import chat;
    import tools;
    import session;
}

/// A tool's network and storage grants belong to its provider component.
world tool-provider {
    export tools;
}

/// An agent that can be handed runs: the `agent` world plus the `run`
/// export. A host drives it through the export, so it needs no ingress and
/// no protocol of its own. The world a spawned child targets, too.
@unstable(feature = agent-run)
world runnable-agent {
    include agent;

    export run;
}

/// The power to drive an agent's runs. Holds only this import. For a
/// component that adapts another protocol onto an agent (an adapter that
/// imports `run` and exports `wasi:http/handler` to serve `POST /task`), or a
/// test double that plays the host.
@unstable(feature = agent-run)
world run-client {
    import run;
}
