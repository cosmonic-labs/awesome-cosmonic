package cosmonic:kafka@0.2.0;

/// Producing records, including the idempotent and transactional paths.
/// ## Every function is `async`
///
/// Including the ones that only read local state — `assignment`, `position`,
/// `fatal-error` — which is not how they would be written for a native
/// implementation. A host *component* plugin's capabilities are installed on a
/// caller's linker as concurrent host functions, and a sync `func` fails to bind
/// there with "type mismatch with async". One sync function is therefore enough
/// to make the whole interface unservable from a component, and this package's
/// `host-plugin` world describes exactly that deployment. An async lift costs a
/// native implementation nothing — the body returns without suspending — so this
/// is the version that both kinds of provider can serve.
@since(version = 0.1.0)
interface producer {
    @since(version = 0.1.0)
    use types.{
        config-entry, error, produce-record, produce-ack, topic-partition,
        partition, watermarks
    };

    /// A producer client.
    ///
    /// Expensive to open and cheap to reuse: it holds connections to every
    /// broker, cached topic metadata and partition leadership. Open one and
    /// keep it for the lifetime of the workload. Opening one per request redoes
    /// metadata discovery every time and defeats batching, which is the whole
    /// reason Kafka producers are fast.
    @since(version = 0.1.0)
    resource producer {
        /// Open a producer.
        ///
        /// `config` takes librdkafka property names verbatim
        /// (`bootstrap.servers`, `acks`, `compression.type`, `linger.ms`,
        /// `transactional.id`, `enable.idempotence`, ...). `bootstrap.servers`
        /// is required.
        ///
        /// Resolves once the client is constructed, which does not imply a
        /// broker connection — the first `send` reports connectivity failures.
        ///
        /// # Typical errors
        /// - `invalid-config`: an unknown or malformed property.
        /// - `invalid-arg`: `bootstrap.servers` missing or unparseable.
        @since(version = 0.1.0)
        open: static async func(config: list<config-entry>)
            -> result<producer, error>;

        /// Produce one record, resolving when the broker acknowledges it under
        /// the configured `acks`.
        ///
        /// # Typical errors
        /// - `msg-timed-out`: not acknowledged within `message.timeout.ms`.
        /// - `queue-full`: local queue at `queue.buffering.max.messages`.
        /// - `unknown-topic-or-part`: topic absent and auto-create disabled.
        /// - `not-leader-for-partition`: leadership moved; retriable after the
        ///   client refreshes metadata, which it does on its own.
        @since(version = 0.1.0)
        send: async func(topic: string, %record: produce-record)
            -> result<produce-ack, error>;

        /// Produce many records to one topic, batched into as few requests as
        /// the partitioning allows.
        ///
        /// Strictly preferable to awaiting `send` in a loop, which serialises
        /// round trips and prevents batching. The result list is positional —
        /// entry N is the outcome of record N — so a partial failure is
        /// reported per record instead of failing the whole call.
        @since(version = 0.1.0)
        send-batch: async func(topic: string, records: list<produce-record>)
            -> result<list<result<produce-ack, error>>, error>;

        /// Stream records to a topic, resolving when every record that entered
        /// the stream has been acknowledged or failed.
        ///
        /// For continuous producing, where the caller does not want to size a
        /// batch. Backpressure comes from the stream: the producer stops
        /// reading while its local queue is full, instead of returning
        /// `queue-full`.
        @since(version = 0.1.0)
        send-stream: async func(topic: string, records: stream<produce-record>)
            -> future<result<_, error>>;

        /// Wait for every queued record to be delivered or fail.
        ///
        /// Await this before dropping the resource when records were produced
        /// through `send-stream`, otherwise queued records are discarded.
        @since(version = 0.1.0)
        flush: async func() -> result<_, error>;

        /// Discard queued records without producing them.
        ///
        /// `in-flight` also cancels records already handed to a broker, whose
        /// outcome then becomes unknown — they may still have been written.
        /// Returns immediately; it does not wait for the queue to drain.
        @since(version = 0.1.0)
        purge: async func(in-flight: bool) -> result<_, error>;

        /// Records queued but not yet delivered.
        @since(version = 0.1.0)
        in-flight-count: async func() -> u32;

        /// Partition count for a topic, from cached metadata or a fresh fetch.
        @since(version = 0.1.0)
        partition-count: async func(topic: string) -> result<u32, error>;

        /// Low and high watermarks for a partition.
        @since(version = 0.1.0)
        watermark-offsets: async func(topic: string, partition: partition)
            -> result<watermarks, error>;

        /// The unrecoverable error this client has entered, if any.
        ///
        /// Once set, every operation fails and the client must be dropped and
        /// reopened. Reached mainly by the idempotent and transactional
        /// producer, when ordering or exactly-once guarantees can no longer be
        /// upheld.
        @since(version = 0.1.0)
        fatal-error: async func() -> option<error>;
    }

    /// A transaction on a producer.
    ///
    /// Requires `transactional.id` in the producer config, which implies
    /// `enable.idempotence`. The lifecycle is strict: `begin`, then produce,
    /// then `commit` or `abort`.
    ///
    /// On any failure check `error.txn-requires-abort`: when set, the only
    /// legal next call is `abort`. When `error.fatal` is set the producer
    /// itself is finished and must be reopened.
    @since(version = 0.1.0)
    resource transaction {
        /// Register the producer with its transaction coordinator, fencing any
        /// previous instance using the same `transactional.id`, and open a
        /// transaction.
        ///
        /// Fencing is the point: it is what makes a restarted producer safe.
        @since(version = 0.1.0)
        begin: static async func(%producer: borrow<producer>)
            -> result<transaction, error>;

        /// Add consumer offsets to this transaction so consuming and producing
        /// commit atomically — the read-process-write pattern.
        ///
        /// `group-id` is the consuming group; `offsets` are the positions to
        /// commit, normally one past the last record processed.
        @since(version = 0.1.0)
        send-offsets: async func(
            offsets: list<topic-partition>,
            group-id: string
        ) -> result<_, error>;

        /// Flush outstanding records and commit.
        @since(version = 0.1.0)
        commit: async func() -> result<_, error>;

        /// Discard the transaction. Records already produced are marked
        /// aborted and are never delivered to `read_committed` consumers.
        @since(version = 0.1.0)
        abort: async func() -> result<_, error>;
    }
}
